generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════
// NAUKA CORE MODELS (RBAC + CMS)
// ═══════════════════════════════════════

/// ─── Users (RBAC, ganti simple User lama) ───
model User {
  id         String   @id @default(cuid())
  fullName   String
  email      String   @unique
  password   String
  avatar     String?
  status     String   @default("active") // active | inactive
  lastLogin  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  userRoles  UserRole[]
  activities Activity[]

  @@map("core_users")
}

/// ─── Roles ───
model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("core_roles")
}

/// ─── Permissions ───
model Permission {
  id       String @id @default(cuid())
  name     String @unique // e.g. "users.view", "articles.create"
  category String      // e.g. "users", "articles", "branding"
  action   String      // view | create | update | delete
  label    String      // Human-readable label

  rolePermissions RolePermission[]

  @@map("core_permissions")
}

/// ─── User-Role Pivot ───
model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("core_user_roles")
}

/// ─── Role-Permission Pivot ───
model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("core_role_permissions")
}

/// ─── Branding (singleton) ───
model Branding {
  id              String   @id @default("default")
  siteName        String   @default("Saka Laptop")
  tagline         String   @default("Pusat Inspeksi & Trade-in Laptop Bekas")
  siteDescription String?
  logo            String?
  favicon         String?
  copyrightText   String   @default("© 2026 Saka Laptop. All rights reserved.")
  instagram       String?
  facebook        String?
  tiktok          String?
  youtube         String?
  linkedin        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("core_branding")
}

/// ─── SEO (singleton) ───
model Seo {
  id              String   @id @default("default")
  siteTitle       String?
  metaDescription String?
  keywords        String?
  homepageTitle   String?
  homepageDesc    String?
  ogTitle         String?
  ogDescription   String?
  ogImage         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("core_seo")
}

/// ─── Media ───
model Media {
  id        String   @id @default(cuid())
  fileName  String
  fileType  String   // jpg | png | webp | svg | pdf
  fileSize  Int      // bytes
  filePath  String
  folder    String   @default("General")
  altText   String?
  width     Int?
  height    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("core_media")
}

/// ─── Settings (singleton) ───
model Settings {
  id                String   @id @default("default")
  phone             String?
  whatsapp          String?
  email             String?
  address           String?
  googleMapsUrl     String?
  googleAnalyticsId String?
  metaPixelId       String?
  smtpHost          String?
  smtpPort          String?
  smtpUsername      String?
  smtpPassword      String?
  maintenanceMode   Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("core_settings")
}

/// ─── Activity Log ───
model Activity {
  id        String   @id @default(cuid())
  userId    String
  action    String // e.g. "login", "create_article", "update_branding"
  details   String? // JSON details
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("core_activity_logs")
}

/// ─── Core Module Registry ───
model CoreModule {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  version     String   @default("1.0.0")
  description String?
  status      String   @default("inactive") // active | inactive
  config      String?  // JSON string (SQLite gak support Json native)
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("core_modules")
}

// ═══════════════════════════════════════
// CMS MODULE (Articles + Categories)
// ═══════════════════════════════════════

/// ─── Articles ───
model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String? // Markdown or HTML content
  coverImage  String?
  status      String   @default("draft") // draft | published | archived
  metaTitle   String?
  metaDesc    String?
  ogImage     String?
  authorId    String?
  categoryId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category ArticleCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@map("cms_articles")
}

/// ─── Article Categories ───
model ArticleCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articles Article[]

  @@map("cms_categories")
}

// ═══════════════════════════════════════
// SAKA LAPTOP BUSINESS MODELS
// ═══════════════════════════════════════

/// InventoryItem = laptop yang sudah diterima dari customer (sudah deal) dan masuk inventory internal.
model InventoryItem {
  id              String   @id @default(cuid())
  nama            String
  brand           String   @default("")
  kategori        String   @default("Ultrabook")
  ram             String   @default("")
  storage         String   @default("")
  gpu             String   @default("")
  processor       String   @default("")
  tahun           Int      @default(0)
  kondisi         String   @default("Bagus")
  kelengkapan     String   @default("Lengkap")
  foto            String   @default("")
  qcChecklist     String   @default("{}")
  qcNotes         String   @default("")
  hargaBeli       Int      @default(0)
  hargaJual       Int      @default(0)
  channel         String   @default("internal")
  status          String   @default("INVENTORY")
  purchaseId      String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// Legacy model — dipertahankan untuk kompatibilitas dengan kode lama.
model Product {
  id             String   @id @default(cuid())
  nama           String
  harga          Int
  kategori       String
  ram            String
  storage        String
  gpu            String
  performaScore  Int      @default(5)
  portableScore  Int      @default(5)
  batteryScore   Int      @default(5)
  image          String   @default("")
  kondisi        String   @default("Bekas")
  kelengkapan    String   @default("Lengkap")
  tahun          Int      @default(0)
  hargaBeli      Int      @default(0)
  sumber         String   @default("stock")
  status         String   @default("available")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          TransactionItem[]
}

model Transaction {
  id             String   @id @default(cuid())
  total          Int
  paymentMethod  String   @default("Cash")
  status         String   @default("completed")
  customerName   String   @default("")
  customerPhone  String   @default("")
  customerAddress String  @default("")
  createdAt      DateTime @default(now())
  items          TransactionItem[]
}

model TransactionItem {
  id            String  @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId     String?
  productName   String
  price         Int
  quantity      Int     @default(1)
}

model Testimoni {
  id       String @id @default(cuid())
  nama     String
  role     String
  teks     String
  rating   Int    @default(5)
  laptop   String
  avatar   String @default("")
}

/// ─── Legacy Lokasi (Profil Toko lama) ───
model Lokasi {
  id          String @id @default("default")
  namaToko    String @default("Saka Laptop")
  tagline     String @default("Pusat Inspeksi & Trade-in Laptop Bekas")
  foto        String @default("/store-front.png")
  alamat      String @default("")
  telepon     String @default("")
  whatsapp    String @default("")
  jamWeekday  String @default("")
  jamWeekend  String @default("")
  lat         Float  @default(-6.2445)
  lng         Float  @default(106.7813)
  mapsLink    String @default("")
}

/// ─── Legacy StoreLogo ───
model StoreLogo {
  id       String @id @default("default")
  logoData String @default("")
}

/// ── MODEL UTAMA: Submission (pengajuan laptop bekas dari customer) ──
model Submission {
  id            String   @id @default(cuid())

  namaLaptop    String
  brand         String   @default("")
  kategori      String   @default("Ultrabook")
  ram           String   @default("")
  storage       String   @default("")
  gpu           String   @default("")
  processor     String   @default("")
  tahun         Int      @default(0)
  kondisi       String   @default("Bagus")
  kelengkapan   String   @default("Lengkap")
  catatan       String   @default("")
  foto          String   @default("")

  customerName  String
  customerPhone String
  customerAddress String @default("")

  estimasiAI    Int      @default(0)
  estimasiNotes String   @default("")

  qcChecklist   String   @default("{}")
  qcNotes       String   @default("")

  hargaPenawaran Int     @default(0)
  penawaranNotes String  @default("")
  penawaranSentAt DateTime?

  customerResponse String @default("")
  customerResponseAt DateTime?

  status        String   @default("RECEIVED")

  inventoryItemId String? @unique

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

// ═══════════════════════════════════════
// HOMEPAGE CONTENT (singleton, editable dari admin)
// ═══════════════════════════════════════
model HomepageContent {
  id                String   @id @default("default")

  // Hero section
  heroEyebrow       String   @default("Pusat Inspeksi & Trade-in Laptop Bekas")
  heroTitle         String   @default("Jual Laptop Bekas Tanpa Ribet.")
  heroSubtitle      String   @default("Kirim foto dan spesifikasi laptop melalui WhatsApp. Tim kami akan membantu proses pengecekan dan penawaran.")
  heroImage         String   @default("https://images.unsplash.com/photo-1581092160562-40aa08e78837?w=1920&q=90")

  // Trust stats (3 items, JSON array of {stat, label, desc})
  trustStats        String   @default("[]")

  // Brand statement
  brandTitle        String   @default("Bukan Sekadar Membeli Laptop.")
  brandCopy         String   @default("Kami membantu proses penilaian perangkat secara transparan sebelum memberikan penawaran.")
  // JSON array of {icon, title, desc}
  brandPoints       String   @default("[]")

  // Workflow stages (5 items, JSON array of {n, title, desc})
  workflowStages    String   @default("[]")

  // Toko photos (JSON array of {src, alt, label})
  tokoPhotos        String   @default("[]")

  // Device categories (JSON array of {label, emoji})
  deviceCategories  String   @default("[]")

  // FAQ (JSON array of {q, a})
  faqs              String   @default("[]")

  // Closing CTA
  closingTitle      String   @default("Laptop Lama Masih Bernilai.")
  closingSubtitle   String   @default("Chat kami sekarang via WhatsApp. Gratis, tanpa komitmen.")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("homepage_content")
}
