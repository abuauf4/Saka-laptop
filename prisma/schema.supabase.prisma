// ──────────────────────────────────────────────────────────
// NAUKA LAPTOP — Supabase (PostgreSQL) Schema
// ──────────────────────────────────────────────────────────
// HOW TO SWITCH FROM SQLITE TO SUPABASE:
//
// 1. Copy this file content to replace prisma/schema.prisma
// 2. Update your .env with real Supabase credentials
// 3. Run: npx prisma db push
// 4. Run: npx tsx prisma/seed.ts
// 5. Deploy to Vercel
//
// ──────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id             String   @id @default(cuid())
  nama           String
  harga          Int
  kategori       String   // Gaming, Editing, Kerja, Sekolah, Ultrabook
  ram            String
  storage        String
  gpu            String
  performaScore  Int      @default(5)
  portableScore  Int      @default(5)
  batteryScore   Int      @default(5)
  image          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  items          TransactionItem[]
}

model Transaction {
  id             String   @id @default(cuid())
  total          Int
  paymentMethod  String   @default("Cash") // Cash, Transfer
  status         String   @default("completed") // completed, refunded, cancelled
  customerName   String   @default("")
  customerPhone  String   @default("")
  customerAddress String  @default("")
  createdAt      DateTime @default(now())
  items          TransactionItem[]
}

model TransactionItem {
  id            String  @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId     String?
  productName   String
  price         Int
  quantity      Int     @default(1)
}

model Testimoni {
  id       String @id @default(cuid())
  nama     String
  role     String
  teks     String
  rating   Int    @default(5)
  laptop   String
  avatar   String @default("")
}

model Lokasi {
  id          String @id @default("default")
  namaToko    String @default("Saka Laptop")
  tagline     String @default("Toko Laptop Terpercaya")
  foto        String @default("/store-front.png")
  alamat      String @default("")
  telepon     String @default("")
  whatsapp    String @default("")
  jamWeekday  String @default("")
  jamWeekend  String @default("")
  lat         Float  @default(-6.2445)
  lng         Float  @default(106.7813)
  mapsLink    String @default("")
}

model User {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  role        String   @default("admin") // developer, admin
  permissions String   @default("[]") // JSON string of PermissionKey[]
  createdAt   DateTime @default(now())
}

model StoreLogo {
  id       String @id @default("default")
  logoData String @default("")
}
