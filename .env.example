# ─── Saka Laptop — Environment Variables ───
# Copy this file to .env (local) or set in Vercel dashboard (production)

# Database (PostgreSQL for production, SQLite for local dev)
# Local SQLite:
DATABASE_URL="file:./db/saka.db"
# Production PostgreSQL (Supabase/Neon/Railway/etc):
# DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# JWT Secret (REQUIRED — use a strong random string in production)
# Generate one: openssl rand -base64 32
JWT_SECRET="change-me-to-a-strong-random-secret"

# Optional: Public site URL (used for SEO/sitemap)
# NEXT_PUBLIC_SITE_URL="https://jakartalaptops.com"

# Optional: Cloudinary (for media uploads — fallback: base64 in DB)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
