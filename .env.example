# ─── Saka Laptop — Environment Variables ───
# Copy this file to .env (local) or set in Vercel dashboard (production)

# Database (REQUIRED)
# Local SQLite (dev only):
DATABASE_URL="file:./db/saka.db"
# Production PostgreSQL (REQUIRED for Vercel):
# DATABASE_URL="postgresql://user:password@host:port/dbname?schema=public"

# JWT Secret (REQUIRED — use a strong random string)
# Generate: openssl rand -base64 32
JWT_SECRET="change-me-to-a-strong-random-secret"

# ─── ONE-TIME SETUP (for production) ───
# Set these in Vercel, then visit /api/setup/init?key=SETUP_KEY to seed DB.
# Remove or blank these AFTER setup is complete.

# Random string to protect setup endpoint (e.g. "my-secret-setup-key-123")
SETUP_KEY=""

# Initial admin password (default: "Saka2026!" if not set)
# CHANGE after first login via /admin/users
ADMIN_INITIAL_PASSWORD="Saka2026!"

# ─── Optional ───
# NEXT_PUBLIC_SITE_URL="https://jakartalaptops.com"

# Cloudinary (for media uploads — fallback: base64 in DB)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
